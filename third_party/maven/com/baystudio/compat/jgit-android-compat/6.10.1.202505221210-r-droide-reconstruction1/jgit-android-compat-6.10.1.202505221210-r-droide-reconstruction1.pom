  <licenses><license><name>Eclipse Distribution License 1.0 (BSD-3-Clause)</name><url>https://www.eclipse.org/org/documents/edl-v10.php</url><distribution>repo</distribution></license></licenses>
  <dependencies>
    <dependency><groupId>com.googlecode.javaewah</groupId><artifactId>JavaEWAH</artifactId><version>1.2.3</version></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>1.7.36</version></dependency>
    <dependency><groupId>commons-codec</groupId><artifactId>commons-codec</artifactId><version>1.17.0</version></dependency>
  </dependencies>
</project>

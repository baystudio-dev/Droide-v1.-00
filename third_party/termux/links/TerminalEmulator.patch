+            mHyperlinkChars -= mHyperlinks.remove(oldest).length();
+        }
+        mCurrentHyperlinkId = mNextHyperlinkId++;
+        mHyperlinks.put(mCurrentHyperlinkId, uri);
+        mHyperlinkChars += uri.length();
